{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Time Limiter",
  "version": "1.0.0",
  "identifier": "com.rayan.gametimelimiter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Time Limiter",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
