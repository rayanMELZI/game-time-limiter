{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Time Limiter",
  "version": "1.2.0",
  "identifier": "com.rayan.gametimelimiter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Time Limiter",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MjkxRkRDNEQ2ODc3MzQKUldRMGQyaE4zQjhwcGhObVFicHN5WEhwVnVMZ0t4ZU5XM3BTSmswRFZHcXkvaWduc0FJWUJSL3AK",
      "endpoints": [
        "https://github.com/rayanMELZI/game-time-limiter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
